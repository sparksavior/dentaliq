# ─────────────────────────────────────────────────────────────
# DentalIQ — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Auth Service (port 3001) ──────────────────────────────────
AUTH_PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TOTP_ISSUER=DentalIQ

# ── Tenant Service (port 3002) ────────────────────────────────
TENANT_PORT=3002

# ── Billing / Estimate (port 3003 / 3004) ────────────────────
BILLING_PORT=3003
ESTIMATE_PORT=3004

# ── Agent Manager (port 3006) ─────────────────────────────────
AGENT_MANAGER_PORT=3006
AGENT_MANAGER_URL=http://localhost:3006
# Exposed to the Next.js client (used by Cortex inbox/dashboard)
NEXT_PUBLIC_AGENT_MANAGER_URL=http://localhost:3006

# ── Stripe ────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create products in Stripe dashboard, paste price IDs here
# https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_CORTEX=price_...

# ── Database ──────────────────────────────────────────────────
# DB_TYPE=sqlite   → zero config, file stored at DATABASE_PATH (default, no Docker needed)
# DB_TYPE=postgres → requires DATABASE_URL pointing at a PostgreSQL server
DB_TYPE=sqlite
DATABASE_PATH=dentaliq.db

# PostgreSQL (only used when DB_TYPE=postgres)
# DATABASE_URL=postgresql://dentaliq:localdev@localhost:5432/dentaliq

# ── LLM / AI Provider ────────────────────────────────────────
# AI features are OPTIONAL. If you don't want AI, leave LLM_PROVIDER=ollama
# but simply don't install/run Ollama — services will fall back to static templates.
# The setup script will ask you at startup whether to enable AI.
#
# Options: ollama | openai | claude | gemini
LLM_PROVIDER=ollama

# Ollama (local, free — no API key needed, runs on your machine)
# Install: https://ollama.com  |  Then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (requires paid API key)
# OPENAI_API_KEY=sk-...

# Anthropic Claude (requires paid API key)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email ─────────────────────────────────────────────────────
# EMAIL_MODE=console  → logs to stdout only (default, zero config)
# EMAIL_MODE=smtp     → sends via SMTP (SMTP_* vars required)
# EMAIL_MODE=resend   → sends via Resend API (RESEND_API_KEY required)
EMAIL_MODE=console
EMAIL_FROM=hello@dentaliq.ca

# SMTP credentials (used when EMAIL_MODE=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your-smtp-password

# Resend API key (used when EMAIL_MODE=resend)
# Get from https://resend.com/api-keys
# RESEND_API_KEY=re_...

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

# ── Admin Portal (port 3005) ─────────────────────────────────
# Long random string used to authenticate the admin dashboard
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=CHANGE_ME_generate_a_random_admin_secret

# ── Frontend ──────────────────────────────────────────────────
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service URLs exposed to the browser (must be NEXT_PUBLIC_ to be bundled)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_TENANT_URL=http://localhost:3002
NEXT_PUBLIC_ESTIMATE_URL=http://localhost:3004

# Demo routes (/demo/starter, /demo/pro, etc.)
# Set to "true" only for marketing/demo deployments — always unset in production
# NEXT_PUBLIC_ENABLE_DEMO=true

# ── Redis (optional) ─────────────────────────────────────────
# Rate limiting is in-memory by default (no Redis needed for dev).
# Set REDIS_URL for distributed rate limiting in multi-instance production.
# REDIS_URL=redis://localhost:6379
