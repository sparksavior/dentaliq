# ─────────────────────────────────────────
# DentalIQ — Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to git
# ─────────────────────────────────────────

# ── App ──────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Auth Service ──────────────────────────
AUTH_PORT=3001
JWT_SECRET=change-me-minimum-32-chars-long-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TOTP_ISSUER=DentalIQ

# ── Tenant Service ────────────────────────
TENANT_PORT=3002

# ── Billing Service ───────────────────────
BILLING_PORT=3003
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Database ──────────────────────────────
DATABASE_URL=postgresql://dentaliq:localdev@localhost:5432/dentaliq
DATABASE_URL_TEST=postgresql://dentaliq:localdev@localhost:5432/dentaliq_test

# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Ollama (local LLM) ────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# ── LLM Provider (ollama | openai | claude) ──
LLM_PROVIDER=ollama

# ── CORS ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

# ── Email (SES or SMTP for dev) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@dentaliq.ca

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
