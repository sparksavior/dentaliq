# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/
build/

# Environment — NEVER commit these
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.suo
*.ntvs*

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Test coverage
coverage/

# Misc
*.tgz
*.db
*.sqlite

# Compiled TypeScript artifacts from internal packages
# (packages use "main": "./src/index.ts" — tsx runs them directly, no build needed)
packages/*/src/*.js
packages/*/src/*.js.map
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Scratch / local experiments
scratch/

# Claude Code local settings
.claude/settings.local.json
