{
  "name": "dentaliq",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push --filter=@dentaliq/db",
    "db:migrate": "turbo run db:migrate --filter=@dentaliq/db",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "seed": "pnpm --filter @dentaliq/auth-service run seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
